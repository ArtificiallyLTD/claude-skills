{
  "name": "artificially-data",
  "displayName": "Artificially Data",
  "description": "Live business data for Claude: LinkedIn research, US government contracts (SAM.gov, USAspending), EU public tenders (TED), hiring signals from LinkedIn and company career sites, and B2B lead lists (YC companies, contacts, tech stacks). Pay per answer from prepaid credits.",
  "version": "1.1.0",
  "author": {
    "name": "Artificially",
    "email": "contact@artificially.io",
    "url": "https://artificially-data.netlify.app"
  },
  "homepage": "https://artificially-data.netlify.app",
  "repository": "https://github.com/ArtificiallyLTD/claude-skills",
  "license": "MIT",
  "keywords": ["linkedin", "government-contracts", "sam-gov", "tenders", "lead-generation", "jobs", "hiring", "ycombinator", "business-data"],
  "icon": "./.claude-plugin/icon.png",
  "documentationUrl": "https://github.com/ArtificiallyLTD/claude-skills#readme",
  "supportUrl": "https://github.com/ArtificiallyLTD/claude-skills/issues",
  "privacyPolicyUrl": "https://artificially-data.netlify.app/privacy.html",
  "termsOfServiceUrl": "https://artificially-data.netlify.app/terms.html",
  "userConfig": {
    "api_key": {
      "type": "string",
